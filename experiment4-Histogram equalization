
import cv2
import numpy as np

img = cv2.imread(r"C:\Users\hp\Downloads\cat.png")
img = cv2.resize(img, (400, 300))

gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
equalized = cv2.equalizeHist(gray)

result = np.hstack((img, cv2.cvtColor(equalized, cv2.COLOR_GRAY2BGR)))

cv2.imshow("Original and Histogram Equalization", result)
cv2.waitKey(0)
cv2.destroyAllWindows()

