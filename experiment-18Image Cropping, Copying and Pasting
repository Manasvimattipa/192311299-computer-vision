
import cv2

image = cv2.imread(r"C:\Users\hp\Downloads\cat.png")

image = cv2.resize(image, (400, 300))

cv2.imshow("Original Image", image)

roi = image[50:200, 50:200]

cropped = roi.copy()

image[50:200, 200:350] = cropped

cv2.imshow("Cropped ROI", roi)

cv2.imshow("Copied and Pasted Image", image)

cv2.waitKey(0)
cv2.destroyAllWindows()
